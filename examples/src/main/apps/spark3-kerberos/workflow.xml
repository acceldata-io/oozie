<workflow-app xmlns="uri:oozie:workflow:1.0" name="spark3-kerberos-wf">

    <start to="spark3-node"/>

    <action name="spark3-node">
        <spark xmlns="uri:oozie:spark-action:1.0">
            <resource-manager>${resourceManager}</resource-manager>
            <name-node>${nameNode}</name-node>
            <master>yarn</master>
            <mode>cluster</mode>
            <name>${sparkJobName}</name>
            <class>${sparkClass}</class>
            <jar>${sparkJar}</jar>
            <spark-opts>
                --principal ${kerberosPrincipal}
                --keytab ${kerberosKeytabAlias}
                --conf spark.executor.memory=${executorMemory}
                --conf spark.executor.cores=${executorCores}
                --conf spark.driver.memory=${driverMemory}
                --conf spark.yarn.maxAppAttempts=1
            </spark-opts>
            <!--
                Distribute the keytab to the launcher container so that spark-submit can read
                it locally and upload it to the YARN staging directory.  Oozie's SparkArgsExtractor
                automatically removes this entry from the --files list passed to spark-submit,
                preventing the "duplicate distributed cache" error that occurs when Spark's YARN
                client also tries to stage the keytab via the --keytab mechanism.
            -->
            <file>${kerberosKeytabHdfsPath}#${kerberosKeytabAlias}</file>
        </spark>
        <ok to="end"/>
        <error to="kill"/>
    </action>

    <kill name="kill">
        <message>Workflow failed, error message[${wf:errorMessage(wf:lastErrorNode())}]</message>
    </kill>

    <end name="end"/>
</workflow-app>
